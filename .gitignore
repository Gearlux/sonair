# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
env/
venv/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/

# IDEs
.vscode/
.idea/
.DS_Store

# Testing / Coverage
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage-*

# Project-Specific (Data & Logs)
data/
logs/
*.log

# Per-backend run output — one entry per path a config or the test suite writes
# to, so a run of ANY backend leaves the tree clean. Grep the example configs for
# `save_dir` / `filename` / `fname` / `checkpoint_dir` / `export_dir` before
# adding a backend, and add its path here in the same change.
lightning_logs/
keras_logs/
tensorflow_logs/
fastai_logs/
torch_runs/
hf_runs/
exported/
checkpoints/
_sonair_test_logs/

# Reports (regenerated by CI — Jenkinsfile / GH Actions)
*-checkstyle.xml
*-diff.txt
flake8.txt
mypy.txt
coverage.xml
coverage-sources.zip
test-report.xml

# Pretrained model caches (downloaded by timm at first use)
*.pt
*.pth
*.ckpt
.cache/
/pyrightconfig.json
